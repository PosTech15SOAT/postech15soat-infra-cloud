include /tmp/nginx-resolver.conf;

upstream os_identity {
    zone os_identity 64k;
    server numberone-os-service.numberone-os.svc.cluster.local:8080 resolve;
}

server {
    listen ${port};
    server_tokens off;
    client_max_body_size 4k;
    proxy_connect_timeout 2s;
    proxy_read_timeout 2s;

    location = /internal/auth/customer-identity {
        if ($request_uri !~ "^/internal/auth/customer-identity(?:[?].*)?$") { return 404; }
        if ($request_method != POST) { return 405; }
        proxy_pass_request_headers off;
        proxy_set_header Host numberone-os-service.numberone-os.svc.cluster.local:8080;
        proxy_set_header Content-Type $http_content_type;
        proxy_set_header X-Correlation-Id $http_x_correlation_id;
        proxy_pass http://os_identity;
    }

    location / {
        return 404;
    }
}
